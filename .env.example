# Copy to .env.dev or .env.prod (both are gitignored) and fill in real values.
# The run scripts pass this file to Flutter with --dart-define-from-file.
# CI builds use this file as-is, so keep the placeholders valid (non-empty, https URL).
ENV=dev
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
