{
  "$description": "Ideaholder design tokens v1.2. One shared structure plus a theme registry. See docs/PLAN.md §11.",
  "$howToAddATheme": "Copy an entry in `themes`, give it a new id, fill every key, and add the id to `release` when it ships. The app stores the chosen theme id as a string and falls back to `default` for unknown ids, so no data migration is needed.",
  "release": [
    "paper",
    "dark"
  ],
  "default": "paper",
  "systemPairing": {
    "light": "paper",
    "dark": "dark"
  },
  "shared": {
    "radius": {
      "sm": 8,
      "md": 14,
      "lg": 20,
      "pill": 999
    },
    "space": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 32,
      "8": 40
    },
    "size": {
      "headerH": 88,
      "alarmBarH": 40,
      "inputH": 44,
      "bannerH": 50,
      "hit": 44,
      "importantBorder": 2,
      "foldLines": 12,
      "macWindowW": 400,
      "macWindowH": 760,
      "macWindowMinW": 340,
      "macWindowMinH": 560,
      "macWindowMaxW": 520
    },
    "type": {
      "title": {
        "size": 22,
        "weight": 600,
        "lineHeight": 1.2
      },
      "section": {
        "size": 13,
        "weight": 600,
        "lineHeight": 1.3
      },
      "body": {
        "size": 15,
        "weight": 400,
        "lineHeight": 1.45
      },
      "reply": {
        "size": 14,
        "weight": 400,
        "lineHeight": 1.45
      },
      "meta": {
        "size": 11,
        "weight": 500,
        "lineHeight": 1.3
      },
      "label": {
        "size": 13,
        "weight": 600,
        "lineHeight": 1.3
      }
    },
    "groupColorIds": [
      "red",
      "orange",
      "yellow",
      "green",
      "teal",
      "sky",
      "blue",
      "violet",
      "pink",
      "graphite"
    ],
    "defaultGroupColor": "blue",
    "memoShadeLevels": [
      1,
      2,
      3,
      4,
      5
    ],
    "memoShadeNames": {
      "en": [
        "Dark",
        "Strong",
        "Medium",
        "Light",
        "Very light"
      ],
      "ko": [
        "진하게",
        "선명하게",
        "중간",
        "연하게",
        "아주 연하게"
      ]
    },
    "$groupColorNote": "Each group color is a family: `base` is the group's identity color (header dot, page dots, reorder list, search results). `shades` are the five memo colors, level 1 (darkest) to 5 (lightest); a memo stores only its level (1-5) or null for the default bubble, so recoloring a group or moving a memo remaps it automatically. `onShade` is the text color for each shade. Generated in OKLCH; every shade meets 4.5:1 with its onShade.",
    "$groupRolesNote": "Inside a group, interactive accents follow the group color. Each theme's `groupRoles` says which shade level plays which role; the widget reads shades[level-1] and onShade[level-1] of the current group's family. Screens without a group (sign-in, settings, all-group search, the empty page) use the theme's `accent`.",
    "groupRoleUsage": {
      "action": "filled buttons inside a group: send, confirm buttons in sheets (Set alarm, Merge, Move here, See Pro on a group page), selection checks, selected filter chips, switches, text buttons (Done/Cancel) on group screens",
      "important": "the 2 px ring of an Important memo (drawn outside a 2 px gap in the list background) and its flag icon",
      "activeDot": "the current page dot",
      "alarmActive": "not a group role: the bell when an alarm is pending uses fixed alarm colors so alarms look the same in every group"
    },
    "neverGroupColored": [
      "danger actions (Delete) – always danger text + trash icon, never a filled button",
      "Sign in with Apple – black/white per Apple guidelines",
      "alarm bar, alarm badges, alarm toast",
      "system-style chrome: macOS menu bar icon, status strips (Offline)",
      "focus rings of text fields (ink)"
    ]
  },
